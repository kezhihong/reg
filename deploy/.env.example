# ============================================================================
# mem_reg Docker Compose 环境变量模板（docs/05 §3；复制为 .env 后填写）
# 生产门禁：APP_DEBUG=true / SMS_MOCK=true / 空密钥任一命中即阻断启动
# ============================================================================

# ---- 应用 ----
APP_ENV=dev
APP_DEBUG=true
LOG_LEVEL=debug

# ---- MySQL ----
MYSQL_DATABASE=mem_reg
MYSQL_USER=app
MYSQL_PASSWORD=app_password_dev
MYSQL_ROOT_PASSWORD=root_password_dev
MYSQL_PORT=3306

# ---- Redis ----
REDIS_PORT=6379

# ---- 密钥（必填；docs/05 §3.2 生成方式）----
# JWT_SECRET=$(openssl rand -hex 64)
# JWT_TICKET_SECRET=$(openssl rand -hex 64)
# TOTP_ENCRYPTION_KEY=$(openssl rand -base64 32)
JWT_SECRET=dev_jwt_secret_change_me_0123456789abcdef0123456789abcdef
JWT_TICKET_SECRET=dev_ticket_secret_change_me_0123456789abcdef0123456789abcdef
TOTP_ENCRYPTION_KEY=dev_totp_key_change_me_0123456789abcdef0123456789ab

# ---- Cookie ----
COOKIE_SECURE=false

# ---- 端口 ----
FRONTEND_PORT=8080
BACKEND_PORT=9501

# ---- 演示门禁 ----
SMS_MOCK=true
KYC_PROVIDER=mock
KYC_PROVIDER_SECRET=mock-secret
OAUTH_REDIRECT_WHITELIST=http://localhost:8080
AUTH_EXCEPT_PATHS=/api/v1/kyc/callback/,/api/v1/2fa/login/verify,/api/v1/2fa/recovery/verify
