# ============================================================================
# mem_reg 后端环境变量模板（docs/05 §3 唯一变量出处；复制为 .env 后填写）
# 生产门禁（docs/05 §3.4）：APP_DEBUG=true / SMS_MOCK=true / 空密钥任一命中即阻断启动
# ============================================================================

# ---- 应用 ----
APP_NAME=mem-reg
APP_ENV=dev
APP_DEBUG=true
APP_KEY=
LOG_LEVEL=200
LOG_JSON=true
SERVER_PORT=9501
WORKER_NUM=4
SCAN_CACHEABLE=false

# ---- MySQL（docs/05 §3.1）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=mem_reg
MYSQL_USER=app
MYSQL_PASSWORD=
DB_POOL_MAX=20

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_MAX=20

# ---- 密钥与令牌（docs/05 §3.2 / docs/04 §8.1）----
JWT_SECRET=
JWT_TICKET_SECRET=
TOTP_ENCRYPTION_KEY=
TOKEN_ACCESS_TTL=900
TOKEN_REFRESH_TTL=2592000
TOKEN_TICKET_TTL=300

# ---- Cookie（docs/04 §3.1）----
COOKIE_SECURE=false
COOKIE_SAMESITE=Strict

# ---- 第三方通道（docs/05 §3.3）----
SMS_PROVIDER=mock
SMS_MOCK=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_WHITELIST=http://localhost:8080
KYC_PROVIDER=mock
KYC_PROVIDER_SECRET=mock-secret
GEOIP_DB_PATH=
CAPTCHA_ENABLED=false

# ---- 安全/限流（docs/04 §4 矩阵）----
RATE_IP_LOGIN=20
RATE_IP_REGISTER=10
RATE_SMS_PER_HOUR=30
RATE_ACCOUNT_FAIL=10
RATE_ACCOUNT_FAIL_2FA=5
RATE_LOCK_MINUTES=15

# ---- 认证豁免路径（公开接口；逗号分隔前缀）----
AUTH_EXCEPT_PATHS=/api/v1/kyc/callback/,/api/v1/2fa/login/verify,/api/v1/2fa/recovery/verify

# ---- 登录默认区号（账号登录输入纯手机号时使用，docs/02 §2.2）----
LOGIN_DEFAULT_COUNTRY_CODE=+86

# ---- 异地判定（docs/01 D5）----
UNUSUAL_WHITELIST=demo

# ---- CORS（同源部署留空；跨域部署时填写）----
CORS_ALLOWED_ORIGIN=
