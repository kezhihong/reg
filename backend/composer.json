{
    "name": "mem-reg/backend",
    "description": "生产级登录注册系统后端（Hyperf 3.x / PHP 8.2 / Swoole）",
    "type": "project",
    "keywords": ["auth", "hyperf", "swoole", "login", "register"],
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "ext-swoole": "*",
        "firebase/php-jwt": "^7.0",
        "hyperf/async-queue": "^3.1",
        "hyperf/command": "^3.1",
        "hyperf/config": "3.1",
        "hyperf/crontab": "^3.1",
        "hyperf/database": "^3.1",
        "hyperf/db-connection": "^3.1",
        "hyperf/event": "^3.1",
        "hyperf/framework": "^3.1",
        "hyperf/http-message": "^3.1",
        "hyperf/http-server": "^3.1",
        "hyperf/logger": "^3.1",
        "hyperf/process": "3.1",
        "hyperf/redis": "^3.1",
        "pragmarx/google2fa": "^8.0",
        "symfony/console": "6.4",
        "symfony/finder": "6.4",
        "symfony/string": "6.4",
        "symfony/translation": "6.4"
    },
    "suggest": {
        "ext-redis": "本地开发需要 Redis 扩展（容器内由 docker-php-ext 提供）"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "post-autoload-dump": [
            "rm -rf runtime/container"
        ],
        "analyse": "php -l bin/hyperf.php && find app config -name '*.php' -exec php -l {} \\;"
    }
}
